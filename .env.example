# osgrep Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# PROVIDER SELECTION
# =============================================================================

# Embedding provider: "local" (default) or "qwen" (cloud via OpenRouter)
# OSGREP_EMBED_PROVIDER=local

# Reranking provider: "local" (default) or "jev" (cloud via OpenRouter)
# "zeroentropy" also means jev, unless ZEROENTROPY_API_ENDPOINT names a server of your own
# OSGREP_RERANK_PROVIDER=local

# =============================================================================
# CLOUD API KEYS (required if using cloud providers)
# =============================================================================

# OpenRouter API key (for Qwen embeddings; Jev reranking on OpenRouter uses it too)
# Get your key at: https://openrouter.ai/keys
QWEN_API_KEY=

# =============================================================================
# OPTIONAL: Custom endpoints/models
# =============================================================================

# QWEN_API_ENDPOINT=https://openrouter.ai/api/v1/embeddings
# QWEN_MODEL=qwen/qwen3-embedding-8b

# A key of its own for Jev (needed when JEV_API_ENDPOINT is not on OpenRouter)
# JEV_API_KEY=
# JEV_API_ENDPOINT=https://openrouter.ai/api/v1/systemone
# JEV_MODEL=typesafe/jev-1.13-20260917

# zerank-2 on a server of your own (ZeroEntropy's hosted API was sunset in September 2026)
# ZEROENTROPY_API_ENDPOINT=
# ZEROENTROPY_API_KEY=
# ZEROENTROPY_MODEL=zerank-2
